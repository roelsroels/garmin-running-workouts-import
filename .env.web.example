# Generate once with: openssl rand -hex 32
GARMIN_WEB_SECRET_KEY=replace-with-a-long-random-value

# Shared state for the CLI and web service. Keep this aligned with the systemd
# unit's ReadWritePaths setting.
GARMIN_WORKOUTS_HOME=/var/lib/garmin-running-workouts
TZ=UTC

# Garmin pacing and cooldown defaults. Increase the interval if needed.
GARMIN_REQUEST_INTERVAL_SECONDS=1
GARMIN_RATE_LIMIT_COOLDOWN_SECONDS=900
GARMIN_RATE_LIMIT_MAX_COOLDOWN_SECONDS=3600
GARMIN_LOGIN_STRATEGY=mobile+requests

# Recommended official source for completed activity summaries and FIT files.
GARMIN_ACTIVITY_PROVIDER=legacy
# Keep legacy during setup; select starter in Settings after OAuth consent and
# WORKOUT_IMPORT permission, or configure this service default explicitly.
GARMIN_TRAINING_PROVIDER=legacy
# GARMIN_PERSONAL_API_KEY=

# Approved Garmin Connect Developer Program Starter application. The redirect
# URI must exactly match the HTTPS URI registered with Garmin.
# GARMIN_STARTER_CLIENT_ID=
# GARMIN_STARTER_CLIENT_SECRET=
# GARMIN_STARTER_REDIRECT_URI=https://planner.example.com/settings/garmin/starter/callback

# Optional explanation provider key. Leave unset when LLM support is disabled.
# RUNNING_PLANNER_LLM_API_KEY=
# For Claude (Anthropic), select Claude in Settings and configure this variable.
# Alternatively, enter a temporary key in the Settings form (one hour, memory only).
# ANTHROPIC_API_KEY=
