[Unit]
Description=Garmin Running Workouts web planner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=garmin-workouts
Group=garmin-workouts
WorkingDirectory=/opt/garmin-running-workouts-import
EnvironmentFile=/etc/garmin-running-workouts/web.env
Environment=GARMIN_WORKOUTS_HOME=/var/lib/garmin-running-workouts
Environment=GARMIN_WEB_COOKIE_SECURE=true
Environment=TZ=UTC
ExecStart=/opt/garmin-running-workouts-import/.venv/bin/gunicorn --workers 1 --threads 1 --bind 127.0.0.1:8765 --timeout 600 --access-logfile - --error-logfile - "garminworkouts.web:create_app()"
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/garmin-running-workouts

[Install]
WantedBy=multi-user.target
