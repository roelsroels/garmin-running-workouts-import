# Copy this file to .env, fill in your credentials locally, and run chmod 600 .env.
# Never commit .env or the local Garmin token store.
GARMIN_USERNAME=your-garmin-email@example.com
GARMIN_PASSWORD=your-garmin-password
GARMIN_ACTIVITY_PROVIDER=legacy
# Workout/calendar publishing: legacy (default) or starter after OAuth consent.
GARMIN_TRAINING_PROVIDER=legacy
# Official Personal API key for activity/FIT reads. Leave empty when using legacy.
GARMIN_PERSONAL_API_KEY=
# Approved Starter app OAuth credentials (server-side use only).
# GARMIN_STARTER_CLIENT_ID=
# GARMIN_STARTER_CLIENT_SECRET=
# GARMIN_STARTER_REDIRECT_URI=https://planner.example.com/settings/garmin/starter/callback
